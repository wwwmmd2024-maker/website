# IR-Jalali environment template.
# Copy to `.env` and fill real values. NEVER commit `.env`.

APP_NAME="IR-Jalali"
APP_ENV=production
APP_DEBUG=false
# Generate per installation (e.g. openssl rand -base64 32 prefixed with base64:).
APP_KEY=
APP_URL=http://localhost
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa_IR
APP_CALENDAR=jalali
ADMIN_PATH=admin

# Production: MySQL 8+. For local development you may use sqlite:
#   DB_DRIVER=sqlite
#   DB_DATABASE=/absolute/path/to/storage/irjalali.sqlite
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=irjalali
DB_USERNAME=irjalali
DB_PASSWORD=

CACHE_DRIVER=file
CACHE_TTL=3600
# Optional Redis cache (falls back to file when unreachable):
# CACHE_DRIVER=redis
# CACHE_REDIS_HOST=127.0.0.1
# CACHE_REDIS_PORT=6379

LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=300
UPLOAD_MAX_KB=10240

# Mail: `log` writes emails to the log (development). IR-SMTP plugin handles
# real SMTP delivery with queue/templates once configured in the admin.
MAIL_DRIVER=log
