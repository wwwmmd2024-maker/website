# Environment & secrets — never commit real configuration values.
.env
.env.local
.env.*.local

# Local databases (SQLite dev instances).
*.sqlite
*.sqlite3
*.db

# Runtime storage (logs, cache, uploads, locks are per-install).
storage/logs/*
storage/cache/*
storage/uploads/*
storage/install.lock
!storage/logs/.gitkeep
!storage/cache/.gitkeep
!storage/uploads/.gitkeep

# Tooling caches.
.phpunit.cache/
.phpstan.cache/
